{
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Python: Attach to Home Assistant",
                "type": "python",
                "request": "attach",
                "port": 5678, // Default debugpy port
                "host": "localhost",
                "justMyCode": false, // Set to false to debug Home Assistant core files as well
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder}",
                        "remoteRoot": "/workspaces/core" // This is the default workspace folder inside the dev container
                    }
                ]
            }
        ]
    }